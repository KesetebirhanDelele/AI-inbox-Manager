# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Environment (dev, staging, prod)
ENVIRONMENT=dev

# Logging
LOG_LEVEL=DEBUG

# ===========================================
# CRITICAL SECRETS - REQUIRED FOR OPERATION
# ===========================================

# OpenAI API Key (for email classification)
OPENAI_API_KEY=your-openai-api-key-here

# Email IMAP Configuration (for reading emails)
EMAIL_ADDRESS=your-email@example.com
EMAIL_PASSWORD=your-gmail-app-password-here
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# ===========================================
# END CRITICAL SECRETS
# ===========================================

# API Configuration
API_BASE_URL=https://api-dev.example.com
API_KEY=your_api_key_here
API_TIMEOUT=30

# Database (if applicable)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=myapp_dev
# DB_USER=myuser
# DB_PASSWORD=secret_password

# External Services
# SERVICE_API_KEY=your_service_key
# SERVICE_URL=https://service.example.com

# Feature Flags
# ENABLE_FEATURE_X=true
# ENABLE_BETA_FEATURES=false

# Testing
# TEST_INTEGRATION=0  # Set to 1 to run integration tests

# Student notification escalation (directives/student-notification-escalation.md)
# Everything below is OFF / safe by default. Nothing is sent to a student until all the live switches are set.
# NOTIFY_ESCALATION_ENABLED=false          # true = Rob's Approve starts the call + text + email sequence
# NOTIFY_CHANNEL_EMAIL=dry_run             # dry_run | ghl | smtp
# NOTIFY_CHANNEL_SMS=dry_run               # dry_run | ghl
# NOTIFY_CHANNEL_CALL=dry_run              # dry_run | ghl
# Roles are assigned on the dashboard Settings page (database). These variables are only a FALLBACK when nobody is assigned:
# APPROVER_ALERT_EMAIL=                    # approver role: follow-ups on a student (no response, needs help, STOP, unreachable)
# CALLBACK_OWNER_EMAIL=                    # callback_owner role: interview callbacks (one business hour, working hours)
# ESCALATION_ALERT_EMAIL=                  # escalation_target role: drafts unapproved for 2 business hours; also copied on notices
# STALE_DRAFT_BUSINESS_MINUTES=120         # how long a draft may wait before the escalation role is told
# BUSINESS_HOURS_TZ=America/Chicago        # BUSINESS_HOURS_START=9  BUSINESS_HOURS_END=17  BUSINESS_DAYS=0,1,2,3,4 (0=Monday)
# NOTIFY_ACK_BASE_URL=https://2-29-47-89.nip.io/api/notifications/ack
# NOTIFY_INBOUND_SECRET=                   # secret for POST /api/notifications/inbound/reply (unset = closed)
# NOTIFY_LEAD_SPACING_MINUTES=3             # minutes between contact with one student and the next (0 = off)
# NOTIFY_SMS_DAILY_SEGMENT_CAP=150         # our share of the shared number's daily budget (hard max 999)
# NOTIFY_BLOCK_TAGS=                       # comma list of GHL opt-out tags (default: do not contact, do not call, ...)
# REPLY_AI_MODE=shadow                     # shadow | live; live also needs the shadow period to be over
# REPLY_AI_SHADOW_UNTIL=2026-10-16
# GoHighLevel (see .claude/skills/ghl-integration/KIT.md). Live needs ALL THREE write switches.
# GHL_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_KEY=                             # Private Integration token (contacts/fields). Secret.
# GHL_CONVERSATIONS_API_KEY=               # SECOND token (conversations scopes). Needed to read replies and calls. Secret.
# GHL_VOICE_AGENT_ID=                    # the OUTBOUND Voice AI agent: only its call logs are read (recommended)
# GHL_RECEPTIONIST_AGENT_ID=              # the INBOUND AI Receptionist: its calls are read to notice students who call back about an interview
# NOTIFY_CALL_MIN_SECONDS=10                # a call shorter than this is not treated as connected (Cora uses 20 for staff calls)
# GHL_LOCATION_ID=
# GHL_WRITE_MODE=shadow                    # shadow | live
# GHL_WRITE_SHADOW_LOG_ONLY=true           # true = log only, no write call
# GHL_WRITE_NOTIFY_FIELDS=false            # per-area switch for the notification fields
# GHL_FIELD_NOTIFY_EMAIL_SUBJECT=Support Issue Ticket #2
# GHL_FIELD_NOTIFY_EMAIL_BODY=Message:
# GHL_FIELD_NOTIFY_SMS=Support issue Ticket #4
# GHL_FIELD_NOTIFY_CALL=interview_notification

# SMTP Configuration (for sending notification emails)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_sending_email@gmail.com
# SMTP_PASSWORD=your_app_password_here
# SMTP_FROM_NAME=Colaberry Interview Support

# Google Drive / Sheets Configuration
# Used for:
#   1. Google Sheets email audit log — appends every classified email as a row
#   2. Student info lookup via Google Drive (optional)
#
# Setup (one-time):
#   1. Google Cloud Console → Enable "Google Sheets API" + "Google Drive API"
#   2. IAM & Admin → Service Accounts → Create → download JSON key
#      Save as: config/service-account-key.json
#   3. Run: python execution/setup_google_sheets.py
#      → Creates the spreadsheet + headers → prints GOOGLE_SHEET_ID
#   4. Paste the IDs below and restart the processing scripts.
#
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=config/service-account-key.json
# GOOGLE_SHEET_ID=                    # filled in by setup_google_sheets.py
# GOOGLE_DRIVE_STUDENTS_FOLDER_ID=your_folder_id_here
# STUDENT_CACHE_TTL_HOURS=4

# WhatsApp Configuration
# WHATSAPP_DEFAULT_SENDER=Jackie
# WHATSAPP_SENDER_JACKIE=214-607-8702
# WHATSAPP_SENDER_ALI=682-597-5784

# Student Assistant Name (for email signatures)
# STUDENT_ASSISTANT_NAME=Robelyn

# Cost & Rate Guardrails (optional — defaults shown)
# MAX_EMAILS_PER_RUN=100         # hard ceiling regardless of --limit
# MAX_COST_PER_RUN_USD=5.0       # abort pre-run if estimated cost exceeds this

# Failure Alerting
# Email address that receives alerts when the pipeline crashes or guardrails trip.
# Uses the existing Gmail OAuth2 credentials — no extra setup needed.
# Leave blank to disable email alerts (failures still logged to logs/alerts.log).
ALERT_EMAIL_TO=your-alert-recipient@example.com
