# Development Dockerfile for FastAPI dashboard.
# Build context is the repo root (see services/dashboard/docker-compose.yml) so
# execution/requirements.txt is reachable — process_runner.py shells out to
# execution/process_inbox_auto.py from this same container, so its deps
# (google-api-python-client, openai, etc.) need to be installed here too.

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies (api + execution)
COPY services/dashboard/api/requirements.txt api-requirements.txt
COPY execution/requirements.txt execution-requirements.txt
RUN pip install --no-cache-dir -r api-requirements.txt -r execution-requirements.txt

# Copy application code
COPY services/dashboard/api/ .

# Expose port
EXPOSE 8000

# Command will be overridden by docker-compose
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
